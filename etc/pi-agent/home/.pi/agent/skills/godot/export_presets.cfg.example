; Minimal Godot 4.x export presets for headless Linux + Windows Desktop exports.
;
; Usage:
;   cp ~/.pi/agent/skills/godot/export_presets.cfg.example <project>/export_presets.cfg
;   Edit the export_path values (and names) as needed, then:
;     mkdir -p <project>/build          ; the target base dir must exist
;     godot --headless --path <project> --export-release "Linux" build/linux
;     godot --headless --path <project> --export-release "Windows Desktop" build/windows.exe
;
; Each export produces a native executable plus a .pck data file beside it.
;
; Required keys (a preset without these is rejected by the exporter):
;   [preset.N]          name, platform, export_path
;   [preset.N.options]  binary_format/architecture, and at least one
;                       texture format (s3tc_bptc below)
;
; Platform names are the exporter display names, e.g. "Linux",
; "Windows Desktop" (not "Windows").
;
; Note: Godot ConfigFile comments use ";", not "#".

[preset.0]

name="Linux"
platform="Linux"
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter=""
exclude_filter=""
export_path="build/linux"

[preset.0.options]

binary_format/architecture="x86_64"
binary_format/embed_pck=false
texture_format/s3tc_bptc=true
texture_format/etc2_astc=false

[preset.1]

name="Windows Desktop"
platform="Windows Desktop"
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter=""
exclude_filter=""
export_path="build/windows.exe"

[preset.1.options]

binary_format/architecture="x86_64"
binary_format/embed_pck=false
texture_format/s3tc_bptc=true
texture_format/etc2_astc=false
