[Unit]
Description=Pi Web UI Session Daemon
After=network.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/home/agent
ExecStart=/usr/bin/pi-web-sessiond
Environment=HOME=/home/agent
Environment=NODE_ENV=production
Environment=PI_WEB_DATA_DIR=/home/agent/.pi-web
# Same read-only config file as the gateway: session-daemon keys
# (spawnSessions / subsessions / environmentFacts) only apply here.
Environment=PI_WEB_CONFIG=/etc/pi-web/config.js
# Same reason as in pi-web.service: sessions are spawned by this daemon.
Environment=PLAYWRIGHT_BROWSERS_PATH=/usr/local/share/ms-playwright
Environment=NODE_PATH=/usr/lib/node_modules
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
