[Unit]
Description=Pi Web UI Gateway (System-wide)
After=network.target
After=pi-web-sessiond.service
Requires=pi-web-sessiond.service

[Service]
Type=simple
# Force the service to execute as the unprivileged agent user
User=agent
Group=agent
WorkingDirectory=/home/agent

ExecStart=/usr/bin/pi-web-server

Environment=HOME=/home/agent
Environment=NODE_ENV=production
Environment=PI_WEB_DATA_DIR=/home/agent/.pi-web
Environment=PI_WEB_CONFIG=/etc/pi-web/config.js

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
